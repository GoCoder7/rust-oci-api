          "version": "repo-lines-v1:sha256:28868c6c4118d0b9257e0cca642231437840af65a1bafea86d244bf77816ca67:"
        }
      ]
    },
    {
      "id": "claim_6daf55b17a0c404b8da4f996b2beefe8",
      "statement": "Both authentication modes end up using the common signing interface: `ApiKeyAuthProvider` passes request data into `OciSigner`, while `InstancePrincipalAuthProvider` resolves signer state and then signs the same `SignRequest` shape.",
