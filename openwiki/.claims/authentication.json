        }
      ]
    },
    {
      "id": "claim_ae66fea2ec0543f899634d07e66e3660",
      "statement": "The API key bootstrap merges `OCI_CONFIG` with per-field environment overrides for the user ID, tenancy ID, region, fingerprint, and private key, while keeping `OCI_COMPARTMENT_ID` optional.",
      "evidence": [
        {
          "resource": "repo://src/client/http.rs#L93-L161",
          "version": "repo-lines-v1:sha256:64b6ca0ffef5e384368179b11ff100bb19299ba4a3579b9e5b3d34e8ef10dcef:"
        }
      ]
    },
    {
      "id": "claim_0277bbb9fc40400d843bbc40ebfdee76",
      "statement": "The Instance Principal bootstrap can derive region and tenancy information from OCI metadata and the instance identity certificate, uses the metadata-derived realm domain when available, and forwards an optional `OCI_METADATA_BASE_URL` override into the builder.",
      "evidence": [
        {
          "resource": "repo://README.md#L67-L93",
          "version": "repo-lines-v1:sha256:62d36a05dd99fb9b35da9035d3be5aa091b1ab4c54d9a2ab10939d893351c2f5:"
