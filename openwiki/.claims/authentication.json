    {
      "id": "claim_2d74a1fe6a3940d884ada0840d030849",
      "statement": "`Oci::resolve_auth_mode_from_env()` applies this precedence order: explicit `OCI_AUTH_MODE`, then OCI metadata autodetection, then API key fallback.",
      "evidence": [
        {
